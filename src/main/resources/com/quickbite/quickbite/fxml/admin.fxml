<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.quickbite.quickbite.controller.AdminController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-header">
            <FontIcon iconLiteral="fas-user-shield" styleClass="header-icon"/>
            <Label text="QuickBite Admin Dashboard" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="messageLabel" styleClass="header-welcome"/>
            <Button text="Reset All Data" styleClass="danger-button" onAction="#onResetAllData"/>
            <Button text="Logout" styleClass="header-button" onAction="#onLogout">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" styleClass="header-button-icon"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="content-panel">

            <Tab text="Restaurants">
                <VBox spacing="12.0" styleClass="content-panel">
                    <Label text="Manage every restaurant on the platform. Blacklisted restaurants disappear from customer browsing immediately."
                           styleClass="card-text" wrapText="true"/>

                    <TableView fx:id="restaurantTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="restNameColumn" text="Name" prefWidth="220.0"/>
                            <TableColumn fx:id="restRatingColumn" text="Rating" prefWidth="100.0"/>
                            <TableColumn fx:id="restStatusColumn" text="Status" prefWidth="150.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10.0">
                        <Button text="Add Restaurant" styleClass="primary-button" onAction="#onAddRestaurant"/>
                        <Button text="Bulk Add" styleClass="secondary-button" onAction="#onBulkAdd"/>
                        <Button text="Edit Selected" styleClass="secondary-button" onAction="#onEditRestaurant"/>
                        <Button text="Whitelist / Blacklist" styleClass="secondary-button" onAction="#onToggleRestaurantActive"/>
                        <Button text="Manage Foods" styleClass="secondary-button" onAction="#onManageFoods"/>
                        <Button text="Delete" styleClass="secondary-button" onAction="#onDeleteRestaurant"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Coupons">
                <VBox spacing="12.0" styleClass="content-panel">
                    <Label text="Create time-limited discount codes for customers to apply at checkout."
                           styleClass="card-text" wrapText="true"/>

                    <TableView fx:id="couponTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="couponCodeColumn" text="Code" prefWidth="140.0"/>
                            <TableColumn fx:id="couponDiscountColumn" text="Discount" prefWidth="90.0"/>
                            <TableColumn fx:id="couponRangeColumn" text="Valid Period" prefWidth="220.0"/>
                            <TableColumn fx:id="couponStatusColumn" text="Status" prefWidth="180.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10.0">
                        <Button text="Add Coupon" styleClass="primary-button" onAction="#onAddCoupon"/>
                        <Button text="Edit Selected" styleClass="secondary-button" onAction="#onEditCoupon"/>
                        <Button text="Enable / Disable" styleClass="secondary-button" onAction="#onToggleCouponActive"/>
                        <Button text="Delete" styleClass="secondary-button" onAction="#onDeleteCoupon"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="All Orders">
                <VBox spacing="12.0" styleClass="content-panel">
                    <Label text="Every order in the system, across every restaurant and customer, updating live."
                           styleClass="card-text" wrapText="true"/>

                    <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="orderIdColumn" text="Order #" prefWidth="70.0"/>
                            <TableColumn fx:id="orderCustomerColumn" text="Customer" prefWidth="130.0"/>
                            <TableColumn fx:id="orderRestaurantColumn" text="Restaurant" prefWidth="150.0"/>
                            <TableColumn fx:id="orderCouponColumn" text="Coupon" prefWidth="90.0"/>
                            <TableColumn fx:id="orderTotalColumn" text="Total" prefWidth="90.0"/>
                            <TableColumn fx:id="orderStatusColumn" text="Status" prefWidth="150.0"/>
                            <TableColumn fx:id="orderDateColumn" text="Placed On" prefWidth="160.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
