<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.quickbite.quickbite.controller.AdminController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-header">
            <FontIcon iconLiteral="fas-user-shield" styleClass="header-icon"/>
            <Label text="QuickBite Admin Dashboard" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" styleClass="header-button" onAction="#onLogout">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" styleClass="header-button-icon"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" styleClass="content-panel">
            <Label text="Welcome, Admin" styleClass="section-title"/>
            <Label text="Manage the QuickBite platform. These sections will be connected in later phases."
                   styleClass="card-text"/>

            <GridPane hgap="20.0" vgap="20.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                </columnConstraints>

                <Button text="Restaurants" styleClass="admin-tile" contentDisplay="TOP" graphicTextGap="10.0"
                        prefHeight="120.0" maxWidth="1.7976931348623157E308"
                        GridPane.columnIndex="0" GridPane.rowIndex="0" onAction="#onRestaurants">
                    <graphic><FontIcon iconLiteral="fas-store" styleClass="admin-tile-icon"/></graphic>
                </Button>

                <Button text="Food Items" styleClass="admin-tile" contentDisplay="TOP" graphicTextGap="10.0"
                        prefHeight="120.0" maxWidth="1.7976931348623157E308"
                        GridPane.columnIndex="1" GridPane.rowIndex="0" onAction="#onFoodItems">
                    <graphic><FontIcon iconLiteral="fas-utensils" styleClass="admin-tile-icon"/></graphic>
                </Button>

                <Button text="Orders" styleClass="admin-tile" contentDisplay="TOP" graphicTextGap="10.0"
                        prefHeight="120.0" maxWidth="1.7976931348623157E308"
                        GridPane.columnIndex="0" GridPane.rowIndex="1" onAction="#onOrders">
                    <graphic><FontIcon iconLiteral="fas-clipboard-list" styleClass="admin-tile-icon"/></graphic>
                </Button>

                <Button text="Delivery Management" styleClass="admin-tile" contentDisplay="TOP" graphicTextGap="10.0"
                        prefHeight="120.0" maxWidth="1.7976931348623157E308"
                        GridPane.columnIndex="1" GridPane.rowIndex="1" onAction="#onDeliveryManagement">
                    <graphic><FontIcon iconLiteral="fas-motorcycle" styleClass="admin-tile-icon"/></graphic>
                </Button>
            </GridPane>

            <Label fx:id="infoLabel" styleClass="info-label"/>
        </VBox>
    </center>
</BorderPane>