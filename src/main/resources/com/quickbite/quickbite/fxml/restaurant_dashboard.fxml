<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.quickbite.quickbite.controller.RestaurantDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-header">
            <FontIcon iconLiteral="fas-store" styleClass="header-icon"/>
            <Label fx:id="restaurantNameLabel" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="messageLabel" styleClass="header-welcome"/>
            <Button text="Logout" styleClass="header-button" onAction="#onLogout">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" styleClass="header-button-icon"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0" styleClass="content-panel">

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="Incoming Orders" styleClass="section-title"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="incomingOrdersBox" spacing="12.0" styleClass="list-box"/>
                </ScrollPane>
            </VBox>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="In Progress" styleClass="section-title"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="activeOrdersBox" spacing="12.0" styleClass="list-box"/>
                </ScrollPane>
            </VBox>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="Completed" styleClass="section-title"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="completedOrdersBox" spacing="12.0" styleClass="list-box"/>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>
</BorderPane>