<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.quickbite.quickbite.controller.RestaurantController">

    <top>
        <VBox>
            <Label fx:id="offlineBar" styleClass="offline-bar" maxWidth="1.7976931348623157E308"
                   text="You are currently offline. Connect to the internet to order food."
                   visible="false" managed="false"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-header">
                <FontIcon iconLiteral="fas-utensils" styleClass="header-icon"/>
                <Label text="QuickBite" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <FontIcon iconLiteral="fas-user" styleClass="header-icon"/>
                <Label fx:id="welcomeLabel" styleClass="header-welcome"/>
                <Button fx:id="discoverButton" text="Discover a Dish" styleClass="header-button" onAction="#onDiscoverDish">
                    <graphic>
                        <FontIcon iconLiteral="fas-lightbulb" styleClass="header-button-icon"/>
                    </graphic>
                </Button>
                <Button text="Order History" styleClass="header-button" onAction="#onOrderHistory">
                    <graphic>
                        <FontIcon iconLiteral="fas-receipt" styleClass="header-button-icon"/>
                    </graphic>
                </Button>
                <Button text="Logout" styleClass="header-button" onAction="#onLogout">
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" styleClass="header-button-icon"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox fx:id="sidePanel" spacing="12.0" styleClass="side-panel">
            Label text="Restaurants" styleClass="section-title"/>

            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input search-field-box">
                <FontIcon iconLiteral="fas-search" styleClass="search-icon"/>
                <TextField fx:id="restaurantSearchField" promptText="Search restaurants..."
                           styleClass="search-text-field" HBox.hgrow="ALWAYS"/>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="restaurantList" spacing="12.0" styleClass="list-box"/>
            </ScrollPane>
        </VBox>
    </left>

    <center>
        <VBox spacing="12.0" styleClass="content-panel">
            <Label fx:id="menuTitleLabel" text="Select a restaurant" styleClass="section-title"/>

            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input search-field-box">
                <FontIcon iconLiteral="fas-search" styleClass="search-icon"/>
                <TextField fx:id="foodSearchField" promptText="Search food..."
                           styleClass="search-text-field" HBox.hgrow="ALWAYS"/>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="foodList" spacing="10.0" styleClass="list-box">
                    <Label text="Choose a restaurant on the left to see its menu." styleClass="card-text"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <VBox styleClass="order-bar" spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <FontIcon iconLiteral="fas-tag" styleClass="search-icon"/>
                <TextField fx:id="couponField" promptText="Coupon code (try WELCOME10)" styleClass="input" prefWidth="220.0"/>
                <Button text="Apply" styleClass="secondary-button" onAction="#onApplyCoupon"/>
                <Label fx:id="couponMessageLabel" styleClass="info-label"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label fx:id="totalLabel" styleClass="total-label"/>
                <Label fx:id="messageLabel" styleClass="error-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Place Order" styleClass="primary-button" onAction="#onPlaceOrder">
                    <graphic>
                        <FontIcon iconLiteral="fas-shopping-bag" styleClass="primary-button-icon"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
